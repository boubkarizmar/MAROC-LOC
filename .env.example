# ============================================================
# MAROC-LOC Environment Configuration
# Copy to .env and fill in real values before deployment
# ============================================================

# -------------------- DATABASE --------------------
POSTGRES_PASSWORD=CHANGE_ME_32_CHAR_MINIMUM

# -------------------- REDIS --------------------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# -------------------- JWT & ENCRYPTION --------------------
JWT_SECRET=CHANGE_ME_64_CHAR_MINIMUM_FOR_HS256_SECURITY
ENCRYPTION_SECRET=CHANGE_ME_32_CHAR_MINIMUM_FOR_AES_GCM

# -------------------- SMTP / EMAIL --------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@marocloc.ma
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD

# -------------------- CMI PAYMENT (Morocco) --------------------
CMI_MERCHANT_ID=YOUR_CMI_MERCHANT_ID
CMI_STORE_KEY=YOUR_CMI_STORE_KEY
CMI_API_KEY=YOUR_CMI_API_KEY

# -------------------- STRIPE (Optional) --------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# -------------------- URLS --------------------
FRONTEND_URL=https://marocloc.ma
BACKEND_URL=https://api.marocloc.ma

# -------------------- MONITORING --------------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA

# -------------------- AI SERVICE (Optional) --------------------
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=
