# Application
DEBUG=false
CORS_ORIGINS=["*"]

# PostgreSQL and conversation memory
DATABASE_URL=postgresql+psycopg2://marocloc:marocloc_secret@localhost:5432/marocloc_db
SESSION_DB_URL=sqlite:///./ai_sessions.db
SESSION_TTL_HOURS=24

# ChromaDB
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=properties

# Models
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LLM_MODEL=google/flan-t5-base
LLM_MAX_LENGTH=512
WHISPER_MODEL=openai/whisper-base

# RAG
RAG_TOP_K=5
RAG_SYNC_LIMIT=10000
MIN_VECTOR_SCORE=0.15
